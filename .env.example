# Copy to .env and fill in. .env is gitignored.
# Empty is treated as unset everywhere, so leave optional lines blank.

# --- required ---
# Your Atlassian account email, not your Bitbucket username and not the token name.
ATLASSIAN_EMAIL=
# https://id.atlassian.com/manage-profile/security/api-tokens
# Use "Create API token with scopes" and pick Bitbucket. A token with no scopes
# returns 401 with an empty body.
# Scopes: read:repository:bitbucket, read:pullrequest:bitbucket
# read:pullrequest already covers commenting, so no write scope is needed.
BITBUCKET_API_TOKEN=

# --- optional: pin one repository ---
# Set these and the tools stop needing workspace and repo_slug on every call.
# They are the two segments in bitbucket.org/<workspace>/<repo_slug>.
BITBUCKET_WORKSPACE=
BITBUCKET_REPO_SLUG=

# --- optional: Jira ---
# Both must be set, or get_jira_issue is not registered at all.
# This is a separate token from the Bitbucket one; a Bitbucket-scoped token
# cannot read Jira.
# Scopes: read:jira-work and read:jira-user
# (granular: read:issue:jira, read:comment:jira, read:user:jira)
# read:jira-user is what puts a name on each comment.
# Use the plain site URL. If the token is scoped, the server resolves the cloud
# id and retries through the gateway on its own.
JIRA_BASE_URL=
JIRA_API_TOKEN=

# --- optional: your own review checklist ---
# Its contents replace the checklist in the review prompt. Keep it outside this
# repository. Missing or empty falls back to the default and logs to stderr.
REVIEW_CHECKLIST_PATH=
